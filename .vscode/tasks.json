{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start PHP server",
            "type": "shell",
            "command": "php",
            "args": [
                "-S",
                "localhost:8080",
                "-t",
                "${workspaceFolder}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Development Server.*started",
                    "endsPattern": ".*Development Server.*started"
                }
            }
        }
    ]
}
